<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permite acessar arquivos e diretórios reais diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redireciona todas as demais rotas para o index.html da SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Cache headers otimizados para SPA Vite
<IfModule mod_headers.c>
  # Assets com hash no nome (imutáveis por 1 ano)
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML principal da aplicação (sem cache agressivo para atualizações imediatas)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Proteções de cabeçalho
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Compressão Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
